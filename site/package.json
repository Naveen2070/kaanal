{
  "name": "kaanal-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "sync-schema": "node -e \"require('fs').mkdirSync('public/schema',{recursive:true});require('fs').copyFileSync('../crates/kaanal-core/kaanal.schema.json','public/schema/v1.json')\"",
    "dev": "pnpm sync-schema && astro dev",
    "build": "pnpm sync-schema && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0"
  }
}
