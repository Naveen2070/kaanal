---
import config from "virtual:starlight/user-config";

import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";

const shouldRenderSearch =
  config.pagefind || config.components.Search !== "@astrojs/starlight/components/Search.astro";

const pathname = Astro.url.pathname;
const navItems = [
  {
    label: "Docs",
    href: "/docs/",
    icon: "book",
    match: (p: string) =>
      p === "/docs/" ||
      (p.startsWith("/docs/") &&
        !p.startsWith("/docs/start/quick-start/") &&
        !p.startsWith("/docs/guides/simulate/studio/") &&
        !p.startsWith("/docs/comparison/")),
  },
  {
    label: "Quick start",
    href: "/docs/start/quick-start/",
    icon: "bolt",
    match: (p: string) => p.startsWith("/docs/start/quick-start/"),
  },
  {
    label: "Studio",
    href: "/docs/guides/simulate/studio/",
    icon: "nodes",
    match: (p: string) => p.startsWith("/docs/guides/simulate/studio/"),
  },
  {
    label: "Comparison",
    href: "/docs/comparison/",
    icon: "chart",
    match: (p: string) => p.startsWith("/docs/comparison/"),
  },
] as const;
---

<script is:inline>
  (() => {
    try {
      if (localStorage.getItem("kaanal-docs-sidebar") === "collapsed") {
        document.documentElement.dataset.sidebarCollapsed = "true";
      }
    } catch {}
  })();
</script>

<div class="kaanal-header-inner">
  <div class="kaanal-header-left">
    <SiteTitle />
  </div>

  <div class="kaanal-header-right">
    <div class="kaanal-header-search print:hidden">
      {shouldRenderSearch && <Search />}
    </div>

    <nav class="kaanal-nav-links print:hidden" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={["kaanal-nav-link", "kaanal-nav-hide-md", { "is-active": item.match(pathname) }]}
        >
          {item.icon === "book" && (
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
            </svg>
          )}
          {item.icon === "bolt" && (
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
            </svg>
          )}
          {item.icon === "nodes" && (
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1.5" />
              <rect x="14" y="3" width="7" height="7" rx="1.5" />
              <rect x="14" y="14" width="7" height="7" rx="1.5" />
              <path d="M10 6.5h4M17.5 10v4" />
            </svg>
          )}
          {item.icon === "chart" && (
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="20" x2="18" y2="10" />
              <line x1="12" y1="20" x2="12" y2="4" />
              <line x1="6" y1="20" x2="6" y2="14" />
            </svg>
          )}
          <span>{item.label}</span>
        </a>
      ))}

      <a
        href="https://github.com/Naveen2070/kaanal"
        class="kaanal-nav-link kaanal-nav-hide-sm"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z" />
        </svg>
        <span class="kaanal-nav-hide-md">GitHub</span>
      </a>

      <button
        type="button"
        id="kaanal-docs-theme-toggle"
        class="kaanal-theme-btn kaanal-nav-hide-sm"
        aria-label="Switch theme"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <span class="kaanal-theme-label"><span data-to="dark">Dark</span><span data-to="light">Light</span></span>
      </button>
    </nav>
  </div>
</div>

<script>
  (() => {
    const btn = document.getElementById("kaanal-docs-theme-toggle");
    const current = () =>
      document.documentElement.dataset.theme === "light" ? "light" : "dark";
    const syncLabel = () => {
      const target = current() === "light" ? "Dark" : "Light";
      if (btn) btn.setAttribute("aria-label", `Switch to ${target.toLowerCase()} theme`);
    };
    syncLabel();
    if (btn) {
      btn.addEventListener("click", () => {
        const next = current() === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("starlight-theme", next);
        } catch {}
        syncLabel();
      });
    }
  })();
</script>

<style>
  @layer starlight.core {
    .kaanal-header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      width: 100%;
      max-width: 1240px;
      margin: 0 auto;
      height: 100%;
    }

    .kaanal-header-left {
      display: flex;
      align-items: center;
      min-width: 0;
      flex-shrink: 0;
    }

    .kaanal-header-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
    }

    .kaanal-header-search {
      display: flex;
      align-items: center;
    }

    .kaanal-nav-links {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .kaanal-nav-link {
      display: inline-flex;
      align-items: center;
      gap: 0.38rem;
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--kaanal-muted);
      padding: 0.4rem 0.7rem;
      border-radius: 8px;
      white-space: nowrap;
      transition: color 120ms ease, background-color 120ms ease;
    }

    .kaanal-nav-link:hover {
      color: var(--kaanal-text);
      background: var(--kaanal-raised);
    }

    .kaanal-nav-link.is-active {
      color: var(--kaanal-text);
      background: var(--kaanal-well);
    }

    .kaanal-theme-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.375rem 0.65rem;
      border-radius: 8px;
      border: 1px solid var(--kaanal-border);
      background: var(--kaanal-sheet);
      color: var(--kaanal-text);
      font-size: 0.8125rem;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
    }

    /* "Light" and "Dark" differ by 1.7px; reserve the wider so the toggle never nudges the nav */
    .kaanal-theme-label {
      display: inline-block;
      min-width: 2.4em;
    }

    /* The label names the theme the button switches to. Pure CSS from <html data-theme>, which the head script
       sets before first paint, so the word is right from the first frame (a script that swapped "Theme" for
       Light/Dark after load made the label flicker on every page change). */
    .kaanal-theme-label [data-to="dark"] {
      display: none;
    }

    html[data-theme="light"] .kaanal-theme-label [data-to="dark"] {
      display: inline;
    }

    html[data-theme="light"] .kaanal-theme-label [data-to="light"] {
      display: none;
    }

    .kaanal-theme-btn:hover {
      background: var(--kaanal-raised);
    }

    .kaanal-nav-hide-sm {
      display: none;
    }

    .kaanal-nav-hide-md {
      display: none;
    }

    @media (min-width: 50rem) {
      .kaanal-nav-hide-sm {
        display: inline-flex;
      }
    }

    @media (min-width: 68rem) {
      .kaanal-nav-hide-md {
        display: inline-flex;
      }
    }
  }
</style>
