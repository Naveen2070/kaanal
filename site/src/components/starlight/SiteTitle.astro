---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="kaanal-site-title">
  <span class="kaanal-brand-mark" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
      <clipPath id="kaanal-nav-sun">
        <path d="M3.2 13.5A8.8 8.8 0 0 1 20.8 13.5Z"></path>
      </clipPath>
      <g clip-path="url(#kaanal-nav-sun)">
        <rect x="2" y="3.9" width="20" height="3.7"></rect>
        <rect x="2" y="8.5" width="20" height="2.4"></rect>
        <rect x="2" y="12.4" width="20" height="1.1"></rect>
      </g>
      <line x1="1" x2="23" y1="14.9" y2="14.9" stroke="currentColor" stroke-width="1.1" opacity="0.55"></line>
      <rect x="4.6" y="16.3" width="14.8" height="1.8" rx="0.9" opacity="0.7"></rect>
      <rect x="7.4" y="19" width="11.2" height="1.6" rx="0.8" opacity="0.45"></rect>
      <rect x="3.2" y="21.5" width="7.6" height="1.3" rx="0.65" opacity="0.26"></rect>
    </svg>
  </span>
  <span class="kaanal-brand-name" translate="no">kaanal</span>
  <span class="kaanal-brand-tamil" lang="ta">கானல்</span>
</a>

<style>
  @layer starlight.components {
    .kaanal-site-title {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      text-decoration: none;
      color: var(--kaanal-text);
      font-weight: 600;
      font-size: 1.05rem;
      letter-spacing: -0.02em;
      white-space: nowrap;
      min-width: 0;
    }

    .kaanal-brand-mark {
      color: var(--kaanal-accent);
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
    }

    .kaanal-brand-tamil {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--kaanal-muted);
      padding: 0.1rem 0.45rem;
      border-radius: 999px;
      border: 1px solid var(--kaanal-border);
      background: var(--kaanal-sheet);
      line-height: 1.35;
    }
  }
</style>
