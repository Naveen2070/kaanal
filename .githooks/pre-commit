#!/bin/sh
# Pre-commit: checks only what the staged files can affect, so a small change commits quickly.
#   Rust changed  -> cargo fmt --check, clippy on the changed crates and the crates that depend on them,
#                    and only the tests the change can reach: the integration-test binaries of a changed
#                    test file, the unit tests of a changed module, the tests that carry its name, else
#                    that crate's suite. Dependents are linted, not tested.
#   UI changed    -> vp check, then `vp test related` on the staged files (all the tests when a config,
#                    the lockfile or anything outside ui/src changed)
#   Rust or UI    -> scripts/check-file-size.sh
#   A lock file   -> node scripts/third-party-licenses.mjs --check (THIRD_PARTY_LICENSES.md must match)
#   Markdown      -> dprint check
#   scripts/x.mjs -> node --test scripts/x.test.mjs when it exists
# How wide to go (the CI always runs everything):
#   KAANAL_HOOK=crate   git commit ...   the whole suite of each changed crate
#   KAANAL_HOOK=deps    git commit ...   crate, plus the whole suite of every crate that depends on it
#   KAANAL_HOOK_FULL=1  git commit ...   everything: whole workspace, all UI tests, markdown
# PowerShell: $env:KAANAL_HOOK_FULL = 1; git commit ...; Remove-Item Env:KAANAL_HOOK_FULL
# The plan comes from scripts/hook-plan.mjs (needs node); if it fails, the hook falls back to everything.
# Enable: git config core.hooksPath .githooks
[ -f Cargo.toml ] || exit 0

say() { echo "pre-commit: $*"; }

files=$(git diff --cached --name-only)
if [ -z "$files" ] && [ "$KAANAL_HOOK_FULL" != 1 ]; then
    say "nothing staged, nothing to check"
    exit 0
fi

if [ "$KAANAL_HOOK_FULL" = 1 ]; then
    plan="rust yes
clippy --workspace
test --workspace
ui all
licenses yes
docs yes"
    say "full run (KAANAL_HOOK_FULL=1)"
elif command -v node >/dev/null 2>&1 && plan=$(printf '%s\n' "$files" | node scripts/hook-plan.mjs); then
    :
else
    say "could not plan from the staged files (node missing or the plan failed): running everything"
    plan="rust yes
clippy --workspace
test --workspace
ui all
licenses yes
docs yes"
fi

field() { printf '%s\n' "$plan" | sed -n "s/^$1 //p"; }

printf '%s\n' "$plan" | sed -n 's/^note /pre-commit: /p'

# ---- Rust
if [ "$(field rust)" = yes ]; then
    say "cargo fmt --check"
    cargo fmt --all --check || { echo "fmt failed: run 'cargo fmt --all'"; exit 1; }
    printf '%s\n' "$plan" | sed -n 's/^clippy //p' | while IFS= read -r args; do
        say "cargo clippy $args"
        # shellcheck disable=SC2086
        cargo clippy $args --all-targets -- -D warnings || exit 1
    done || { echo "clippy failed"; exit 1; }
    printf '%s\n' "$plan" | sed -n 's/^test //p' | while IFS= read -r args; do
        say "cargo test $args"
        # shellcheck disable=SC2086
        cargo test $args --quiet || exit 1
    done || exit 1
else
    say "no Rust files staged: skipping fmt, clippy and cargo test"
fi

# ---- file size (the gate is not part of cargo or vp, so run it here)
if [ "$(field rust)" = yes ] || [ "$(field ui)" != none ]; then
    say "file size gate"
    bash scripts/check-file-size.sh || { echo "file size gate failed: split the file (AGENTS.md, Code layout)"; exit 1; }
fi

# ---- node scripts with a test next to them (and the hook planner itself)
printf '%s\n' "$plan" | sed -n 's/^node-test //p' | while IFS= read -r t; do
    say "node --test $t"
    node --test "$t" || exit 1
done || { echo "node test failed"; exit 1; }

# ---- third-party notices (cheap, no tools: compares the lock-file hashes in the file's first line)
if [ "$(field licenses)" = yes ]; then
    say "third-party licenses check"
    node scripts/third-party-licenses.mjs --check || {
        echo "regenerate and stage it: node scripts/third-party-licenses.mjs (needs cargo-about and 'cd ui && pnpm install'; on Windows put the pnpm 12 shim before WinGet's old pnpm.exe on PATH)"
        exit 1
    }
fi

# ---- markdown
if [ "$(field docs)" = yes ]; then
    if command -v dprint >/dev/null 2>&1; then
        say "dprint check"
        dprint check || { echo "dprint failed: run 'dprint fmt'"; exit 1; }
    else
        say "dprint not found, skipping markdown check (install: cargo install dprint)"
    fi
fi

# ---- UI
ui=$(field ui)
if [ "$ui" = changed ] || [ "$ui" = all ]; then
    if [ -f ui/package.json ] && command -v pnpm >/dev/null 2>&1; then
        say "ui check (vp check: format, lint, types)"
        (cd ui && pnpm run check) || {
            echo "ui check failed: 'cd ui && vp check --fix' fixes formatting, the rest is lint/types"
            exit 1
        }
        if [ "$ui" = all ]; then
            say "ui tests (all)"
            (cd ui && pnpm exec vp test run) || exit 1
        else
            # the staged UI files, relative to ui/ (the plan prints them); vitest runs the tests that import them
            uifiles=$(field uifiles)
            say "ui tests (related to: $uifiles)"
            # shellcheck disable=SC2086
            (cd ui && pnpm exec vp test related $uifiles --run --passWithNoTests) || exit 1
        fi
    else
        say "pnpm not found, cannot check the ui"
        exit 1
    fi
else
    say "no UI files staged: skipping the ui check and tests"
fi
